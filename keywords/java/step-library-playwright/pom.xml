<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>step-library-playwright</artifactId>
	<name>${project.groupId}:${project.artifactId}</name>
	<description>
		Atomic Step keywords driving a web application through Playwright, one browser action per keyword, the target
		being resolved through the managed application registry.
	</description>

	<parent>
		<groupId>ch.exense.step.library</groupId>
		<artifactId>step-library-parent</artifactId>
		<version>0.0.0-MASTER-SNAPSHOT</version>
		<relativePath>../../../step-library-parent</relativePath>
	</parent>

	<dependencies>
		<dependency>
			<groupId>ch.exense.step.library</groupId>
			<artifactId>step-library-commons</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<version>1.63.0</version>
		</dependency>
		<dependency>
			<groupId>ch.exense.step</groupId>
			<artifactId>application-registry</artifactId>
			<version>0.0.0-SED-5061-SNAPSHOT</version>
		</dependency>

		<!-- Generates the keyword schemas in the tests, as Step does from the @Input annotations -->
		<dependency>
			<groupId>ch.exense.step</groupId>
			<artifactId>step-api-json-schema</artifactId>
			<version>${step-api.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.glassfish</groupId>
			<artifactId>jakarta.json</artifactId>
			<version>2.0.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
